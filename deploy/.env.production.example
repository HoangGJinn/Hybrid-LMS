# ==============================================================================
# Production Environment Variables Template for EC2 Backend
# Target file on EC2: ~/hybrid-lms/.env
# ==============================================================================

# Application Configuration
NODE_ENV=production
PORT=9595
FRONTEND_URL=https://hoanggiap.id.vn
ADMIN_URL=https://admin.hoanggiap.id.vn

# PostgreSQL Database Configuration
DATABASE_HOST=your-rds-or-aiven-host.com
DATABASE_PORT=5432
DATABASE_USER=your_db_username
DATABASE_PASSWORD=your_secure_db_password
DATABASE_NAME=hybrid_lms_prod
DATABASE_CA_PATH=/app/ca.pem

# JWT & Authentication
JWT_SECRET=replace_with_a_long_random_secret_key_minimum_32_chars
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=1209600000
# Cookie SameSite: 'none' (recommended for cross-subdomain with HTTPS) or 'lax'
REFRESH_COOKIE_SAME_SITE=none

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Initial Administrator Emails (comma-separated)
ADMIN_EMAILS=your-admin-email@example.com

# AWS S3 Storage (Using EC2 IAM Role - No access keys needed)
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=lms-dev-files-hoanggjinn
S3_DOWNLOAD_URL_TTL=900
S3_UPLOAD_URL_TTL=600

