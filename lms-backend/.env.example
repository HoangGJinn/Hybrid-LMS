# APP
NODE_ENV=development
PORT=9595
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# DATABASE
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=hybrid_lms
DATABASE_CA_PATH=./ca.pem

# JWT & AUTH
JWT_SECRET=super_secret_key_change_me
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=1209600000 # 14 days in ms (14 * 24 * 60 * 60 * 1000)
# strict (default in production) | lax (default in dev) | none (frontend and API on different sites, needs HTTPS)
REFRESH_COOKIE_SAME_SITE=lax

# GOOGLE
GOOGLE_CLIENT_ID=your_google_client_id_here

# ADMIN CONFIG (comma-separated list of admin emails on first signup)
ADMIN_EMAILS=admin@example.com

# ENAS-KT: chọn câu hỏi và tính mức hiểu biết (mastery) theo năng lực học sinh.
# QUESTION_SELECTOR=enas bật cả hai; bỏ trống thì dùng bộ chọn rule-based và mastery theo tỉ lệ đúng.
# Gateway lỗi thì tự quay về rule-based (mastery tạm dừng gọi gateway 30 giây sau mỗi lần lỗi).
# QUESTION_SELECTOR=enas
# ENAS_GATEWAY_URL=http://127.0.0.1:8002
# ENAS_GATEWAY_TIMEOUT_MS=15000
