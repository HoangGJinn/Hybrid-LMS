# APP
NODE_ENV=development
PORT=9595
FRONTEND_URL=http://localhost:3000

# DATABASE
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=hybrid_lms

# JWT & AUTH
JWT_SECRET=super_secret_key_change_me
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=1209600000 # 14 days in ms (14 * 24 * 60 * 60 * 1000) or '14d'
# strict (default in production) | lax (default in dev) | none (frontend and API on different sites, needs HTTPS)
# REFRESH_COOKIE_SAME_SITE=strict

# GOOGLE
GOOGLE_CLIENT_ID=your_google_client_id_here
